# Stellar Cyber → Jira (AIxSOC). Copy: cp env.example .env
# API key: Stellar System | Users | API Keys (Bearer refresh token → JWT).
#
# 新環境部署：見 README.md「新環境部署檢查清單」

# Jira Cloud (REST v3). Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# Stellar (host only — no /connect path)
STELLAR_BASE_URL=
STELLAR_API_KEY=
STELLAR_USER_EMAIL=
# Legacy single-tenant filter only. Global multi-tenant poll ignores this value,
# though registry entries may reference it as ${STELLAR_TENANT_ID}.
STELLAR_TENANT_ID=
STELLAR_TIMEOUT_SECONDS=60.0
STELLAR_HTTP_MAX_RETRIES=1
STELLAR_TLS_VERIFY=true

# Jira AIxSOC line
STELLAR_JIRA_PROJECT_KEY=AIXSOC
STELLAR_JIRA_ISSUE_TYPE_ID=10092
STELLAR_JIRA_SEVERITY_FIELD=customfield_10057
STELLAR_JIRA_STATUS_FIELD=customfield_10061
# Leave empty to skip (alert text remains in summary/description)
STELLAR_JIRA_ALERT_NAME_FIELD=customfield_10122
STELLAR_JIRA_RESOLUTION_TAG_FIELD=customfield_10201
STELLAR_RESOLUTION_TAG_MAP_PATH=config/stellar_resolution_tag_map.json
STELLAR_CASE_ID_PREFIX=XSOC
STELLAR_CASE_ID_TIMEZONE=Asia/Taipei
STELLAR_CASE_ID_JIRA_FIELD=customfield_10060
STELLAR_SUMMARY_TEMPLATE=[{severity}][{event_name}][{customer_code}]
STELLAR_DEFAULT_CUSTOMER_CODE=
STELLAR_TENANTS_PATH=config/stellar_tenants.json
# Production multi-tenant: set true for one global poll, then strict
# cust_id + tenant_name classification via config/stellar_tenants.json.
STELLAR_MULTI_TENANT_ENABLED=false
STELLAR_MULTI_TENANT_STRICT=true
STELLAR_SYNC_STATE_DB=data/stellar_sync_state.sqlite
# Keep this global value in multi-tenant mode; tenant ownership is separate metadata.
STELLAR_POLL_SOURCE_ID=stellar
STELLAR_SYNC_LOOKBACK_MINUTES=120
STELLAR_SYNC_PAGE_SIZE=50
STELLAR_SYNC_MAX_PAGES=40
# Jira create + SOC notify only for these Stellar severities (comma-separated). Use * or empty for all.
STELLAR_SYNC_ALLOWED_SEVERITIES=Critical,High
STELLAR_AUTOMATION_INTERVAL_SECONDS=30
STELLAR_AUTOMATION_MIN_INTERVAL_SECONDS=5
STELLAR_AUTOMATION_JIRA_WRITEBACK=true
# Cycle writeback skips tickets whose Jira ``updated`` is unchanged since last check.
STELLAR_WRITEBACK_MAX_ISSUES_PER_CYCLE=100
STELLAR_SYNC_STELLAR_TO_JIRA_STATUS=true
STELLAR_SYNC_STELLAR_TO_JIRA_ASSIGNEE=true
STELLAR_SYNC_JIRA_WORKFLOW_STATUS=true
# Also sync Jira 事件狀態 (customfield_10061) ↔ Stellar status (same option labels)
STELLAR_SYNC_JIRA_CUSTOM_STATUS=true
# When workflow and 事件狀態 disagree on writeback: true=workflow wins, false=事件狀態 wins
STELLAR_STATUS_PREFER_JIRA_WORKFLOW=true
# After Jira ticket is created/linked: false = Stellar duty platform (mirror Stellar→Jira)
STELLAR_JIRA_MASTER_AFTER_LINK=false
# Mirror all linked tickets each cycle (Stellar status/assignee → Jira)
STELLAR_AUTOMATION_JIRA_MIRROR=true
STELLAR_MIRROR_ON_POLL=true
STELLAR_MIRROR_FULL_SCAN=false
STELLAR_MIRROR_MAX_ISSUES_PER_CYCLE=100
STELLAR_MIRROR_CASE_ACTIVITY_TO_JIRA=true
STELLAR_MIRROR_CASE_ACTIVITY_SINCE_LINK=true
STELLAR_MIRROR_CASE_ACTIVITY_MAX_PER_TICKET=20
# Stellar assignee email ↔ Jira accountId (Atlassian Cloud often hides email in API)
STELLAR_JIRA_USER_MAP_PATH=config/stellar_jira_user_map.example.json
# Native Stellar Cyber AI Case Summary (MCP, fail-open).
# The Summary may be generated after Jira creation, so unavailable results are retried.
STELLAR_AI_SUMMARY_ENABLED=true
STELLAR_AI_SUMMARY_JIRA_COMMENT=true
STELLAR_AI_SUMMARY_RETRY_SECONDS=300
STELLAR_AI_SUMMARY_MAX_ATTEMPTS=24
# Jira→Stellar writeback scope
# Status on (duty may close in Jira). Assignee/severity stay Stellar-led unless enabled.
STELLAR_WRITEBACK_SYNC_STATUS=true
STELLAR_WRITEBACK_SYNC_ASSIGNEE=false
STELLAR_WRITEBACK_SYNC_SEVERITY=false
# Staff typically operate one place at a time; status writeback closes Stellar when Jira is Resolved.
STELLAR_JIRA_FIELD_MAP_PATH=config/stellar_jira_field_map.example.json

# Webhook auth (optional; ./serve_api) — endpoints return 503 if secrets not configured
# STELLAR_WEBHOOK_TOKEN=          # required for POST /v1/webhooks/jira-stellar
# SYNC_API_TOKEN=                 # or reuse for X-Sync-Token / X-Stellar-Webhook-Token
# LINE_CHANNEL_SECRET=            # required for POST /v1/webhooks/line
# AI_DATA_API_TOKEN=              # Required for GET /v1/ai-data/* (Bearer / X-AI-Data-Token)

# SOC notification (after successful Jira ticket create; skipped on --dry-run)
# Email and LINE are independent — enable either or both.
# --- Resend (https://resend.com) — recommended when no corporate SMTP ---
# SOC_NOTIFY_ENABLED=true
# RESEND_API_KEY=re_xxxxxxxx
# SOC_NOTIFY_FROM=stellar-jira@yourdomain.com
# SOC_NOTIFY_TO=soc-l1@example.com,soc-l2@example.com
# Test without domain verify: SOC_NOTIFY_FROM=onboarding@resend.dev (only to your Resend account email)
# Test: ./Tools/run notify-test
#
# --- Generic SMTP (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SOC_NOTIFY_FROM=stellar-jira@yourdomain.com
# SOC_NOTIFY_CC=
# SOC_NOTIFY_BCC=
# SOC_NOTIFY_SUBJECT_TEMPLATE=<JJNET XMDR告警> 風險等級：[{severity}] [{customer_code}] 資安事件 [{event_name}]
#
# --- SOC notify AI (Stellar only; Groq free tier OK) ---
# SOC_NOTIFY_AI_ENABLED=true
# SOC_NOTIFY_AI_PROVIDER=groq
# SOC_NOTIFY_AI_API_KEY=gsk_xxxxxxxx
# SOC_NOTIFY_AI_MODEL=llama-3.3-70b-versatile
# SOC_NOTIFY_AI_TIMEOUT_SECONDS=12
# SOC_NOTIFY_AI_FAIL_OPEN=true
#
# --- MaiAgent after Critical/High create (does NOT replace Groq) ---
# Keep SOC_NOTIFY_AI_* + SOC_NOTIFY_TO / LINE_NOTIFY_TO for team broadcast.
# MaiAgent runs only after Jira create (Critical/High), full-case Root Cause,
# and pushes a second LINE message. Empty MAIAGENT_NOTIFY_LINE_TO shares LINE_NOTIFY_TO.
# MAIAGENT_API_KEY=
# MAIAGENT_CHATBOT_ID=254a5b54-8920-4519-9d0c-c2b16ef4c300
# MAIAGENT_BASE_URL=https://api.sungcheng.org/api
# MAIAGENT_TIMEOUT_SECONDS=90
# MAIAGENT_NOTIFY_ENABLED=true
# MAIAGENT_NOTIFY_EMAIL_TO=you@example.com   # optional extra email; never SOC_NOTIFY_TO
# MAIAGENT_NOTIFY_LINE_TO=                   # empty = share LINE_NOTIFY_TO
# MAIAGENT_NOTIFY_ASYNC=true
# MAIAGENT_NOTIFY_ONLY_WITHOUT_CORTEX_CASE_ID=false
# Legacy: all severities including Low/Medium — keep false for Critical/High-only SOC.
# MAIAGENT_ALL_CASES_ENABLED=false
# MAIAGENT_ALL_CASES_LINE_TO=Uxxxxxxxx       # required if all-cases enabled; never LINE_NOTIFY_TO
# MAIAGENT_ALL_CASES_RETRY_SECONDS=600
# Manual test: ./Tools/run maiagent-notify --ticket 1214
# Trial (no push): ./Tools/run maiagent-trial --from-export … --agentic

# --- AIxSOC Decision Intelligence (enabled by code default) ---
DECISION_ENABLED=true
DECISION_APPEND_JIRA_DESCRIPTION=false   # WIP: set true to show AIxSOC Decision block in Jira description
# DECISION_RULES_PATH=config/decision_rules.json
# DECISION_KNOWLEDGE_PATH=config/decision_knowledge.json
# DECISION_ASSETS_PATH=config/decision_assets.json
DECISION_RECORD_AI=true
DECISION_RUN_AI_ON_CREATE=false   # optional: LLM before create; default merge uses notify path once
DECISION_JIRA_COMMENT_ON_CREATE=true   # duty checklist comment after create
DECISION_ONLY_WITHOUT_CORTEX_CASE_ID=true  # Decision only if no Cortex case_id on alerts
DECISION_OUTCOME_ON_WRITEBACK=true
DECISION_OUTCOME_REMIND_ON_WRITEBACK=false  # set true only when pushing TP/FP Dataset loop

# --- Stellar case snapshot archive (enabled by code default) ---
CASE_ARCHIVE_ENABLED=true
# CASE_ARCHIVE_MAX_BYTES=2097152
# CASE_ARCHIVE_DIR=data/case_archive
# Severity-gated (Low/Medium) poll skips do not archive; create/escalation still do.
CASE_ARCHIVE_ON_SEVERITY_ESCALATION=true
DECISION_REEVAL_ON_SEVERITY_ESCALATION=true
# After each write, drop non-milestone versions (decision-linked / first / latest / first-per-severity).
CASE_ARCHIVE_AUTOPRUNE=true
# One-shot cleanup of historical spam: ./Tools/run case-archive-gc
#   ./Tools/run case-archive-gc --apply
# Get key: https://console.groq.com/keys
#
# --- LINE Bot push (optional; same trigger & body as SOC email) ---
# LINE_NOTIFY_ENABLED=true
# LINE_CHANNEL_ACCESS_TOKEN=      # Messaging API → Channel access token (required for push)
# LINE_NOTIFY_TO=                 # U… user / C… group / R… room, 33 chars each, comma-separated
# LINE_NOTIFY_TIMEOUT_SECONDS=15
# LINE_WEBHOOK_REPLY_ID=true      # if webhook enabled: reply sender with their ID
#
# Get userId / groupId (free tier: use webhook.site or POST /v1/webhooks/line):
#   - Copy events[].source.userId (U…) or groupId (C…) — NOT "destination"
#   - ./Tools/run line-verify       check ID
#   - ./Tools/run line-verify --push   send test message
#   - ./Tools/run line-list-followers  paid API only (often 403 on free plans)
# Records: data/line_recipients.json
# Test: ./Tools/run notify-test

# --- CyCraft EDR → Stellar XDR connector (optional; per-tenant) ---
# No native Stellar connector for CyCraft; uses XDR webhook ingest → ATH playbook → Cases.
# Per-tenant UI: xMDR 設定中心 → 外部整合器 (paths + customer key in platform DB).
# Secrets are NEVER shared across tenants — use suffix __{SOURCE_ID} (uppercase, non-alnum → _).
# Example for source_id jjnet (CyCraft 套用於 JJNET，非 jjnet-edr):
#   XCOCKPIT_API_KEY__JJNET=
#   STELLAR_XDR_API_KEY__JJNET=
#   STELLAR_CASES_API_KEY__JJNET=   # optional, incident case sync
# Global service switch + shared defaults (poll interval, vendor labels):
# CYCRAFT_CONNECTOR_ENABLED=false
# STELLAR_BASE_URL=https://...
# STELLAR_XDR_VENDOR=CyCraft
# STELLAR_XDR_SOURCE=XCockpit_EDR
# XCOCKPIT_BASE_URL=https://xcockpit.cycraft.ai
# XCOCKPIT_POLL_MODE=alerts
# XCOCKPIT_POLL_INTERVAL_SECONDS=60
# XCOCKPIT_POLL_LOOKBACK_MINUTES=15
# XCOCKPIT_INCLUDE_CYCRAFT_C=true
# INCIDENT_CASE_SYNC_ENABLED=false
# Per-tenant state: data/cycraft_state/{source_id}.sqlite
# Test: ./Tools/run cycraft-test-xcockpit
# Daemon: ./Tools/run cycraft-poller
# systemd: deploy/systemd/cycraft-xcockpit-connector.service

# Verify: ./Tools/run stellar-verify
# Dry-run: ./Tools/run stellar-sync-dry-run
# Poll once: ./Tools/run stellar-poll
# Monthly report: cp config/stellar_tenants.example.json config/stellar_tenants.json
#   ./Tools/run report-monthly --tenant jjnet --product darktrace --month 2026-05
# Event export: ./Tools/run report-export --tenant jjnet --product darktrace --month 2026-05
# Daemon: ./Tools/run stellar-automation
# systemd: deploy/systemd/ticket-api-stellar-jira.service
# HTTP API: ./serve_api  (optional)
#   POST /v1/webhooks/jira-stellar   Jira → Stellar writeback
#   POST /v1/webhooks/line           LINE events (discover IDs)
#   GET  /health /health/ready
#   POST /v1/auth/login          Platform login (P0)
#   GET  /v1/auth/me             Current user (Bearer token)

# --- Platform auth (PRD v0.1) ---
PLATFORM_ENABLED=true
PLATFORM_DB_PATH=data/platform.db
PLATFORM_SECRET_KEY=change-me-to-a-long-random-string
PLATFORM_SESSION_TTL_HOURS=24
PLATFORM_LOGIN_TOKEN_TTL_MINUTES=10
PLATFORM_REQUIRE_TOTP=true
PLATFORM_TOTP_ISSUER=Stellar SOC Platform
PLATFORM_BOOTSTRAP_ALLOW_PASSWORD_ONLY=false
# Set true only on trusted LAN bootstrap; ignored when PLATFORM_PUBLIC_EXPOSURE=true
PLATFORM_PUBLIC_EXPOSURE=false
PLATFORM_LOGIN_RATE_LIMIT_ATTEMPTS=10
PLATFORM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PLATFORM_SESSION_COOKIE_NAME=soc_session
# PLATFORM_COOKIE_SECURE=            # auto from HTTPS / X-Forwarded-Proto
PLATFORM_COOKIE_SAMESITE=lax
PLATFORM_EXPOSE_BEARER_TOKEN=false
PLATFORM_TRUST_PROXY_HEADERS=true
# Create first admin: ./Tools/run platform-user create admin@example.com 'your-password'

# --- Cloudflare Tunnel (GCP → serve_api) — secrets in .env ONLY, never in chat ---
# Create API token: Account「Cloudflare Tunnel Edit」+ Zone「DNS Edit」
# https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/
# CLOUDFLARE_API_TOKEN=           # only secret you must set
# CLOUDFLARE_TUNNEL_HOSTNAME=xmdr.nine-security.com
# CLOUDFLARE_TUNNEL_NAME=stellar-soc-xmdr
# CLOUDFLARE_ACCOUNT_ID=          # optional; auto from API when running setup
# CLOUDFLARE_ZONE_ID=             # optional; auto from hostname
# CLOUDFLARE_TUNNEL_ORIGIN=http://127.0.0.1:8000
# Then: ./Tools/run cloudflare-tunnel-setup
